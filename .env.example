# PostgreSQL (Neon / Supabase / local)
DATABASE_URL=""

# Admin session signing secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""

# First admin account (created by `pnpm db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Paystack: dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Cloudinary: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site URL (used for Paystack callback)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
