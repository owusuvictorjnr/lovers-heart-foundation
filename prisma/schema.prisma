generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum VolunteerStatus {
  NEW
  CONTACTED
  ACTIVE
  ARCHIVED
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
}

model Donation {
  id        String         @id @default(cuid())
  reference String         @unique
  /// Amount in pesewas (GH₵ 1 = 100)
  amount    Int
  currency  String         @default("GHS")
  donorName String
  email     String
  phone     String?
  anonymous Boolean        @default(false)
  status    DonationStatus @default(PENDING)
  channel   String?
  paidAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
}

model Home {
  id          String   @id @default(cuid())
  name        String
  region      String
  description String
  imageUrl    String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Outreach {
  id              String    @id @default(cuid())
  year            Int
  title           String
  summary         String
  date            DateTime?
  homesCount      Int       @default(0)
  childrenReached Int       @default(0)
  upcoming        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([year])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  caption   String
  year      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([year])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  contact   String
  topic     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Volunteer {
  id        String          @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String?
  status    VolunteerStatus @default(NEW)
  createdAt DateTime        @default(now())
}

model RateLimit {
  key       String   @id
  attempts  Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model SiteContent {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}


